<% layout("/layouts/boilerplate.ejs") %> 

<div class="row mt-3">
    <h1 class="col-6 offset-3">SignUp on WanderLust</h1>
    <div class="col-6 offset-3">
            <form action="/signup" method="POST" class="needs-validation" novalidate>
                
                <div class="mb-3">
                    <lable for="username" class="form-label"> Username </lable>
                    <input 
                    type="text" 
                    name="username" 
                    id="username"
                     class="form-control" 
                     required
                     />

                    <div class="valid-feedback">Lokks Good!</div>

                     </div>

                    <div>
                                <lable for="emailId" class="form-label"> Enter Email-Id </lable>
                            <input 
                            type="text" 
                            name="email" 
                            id="emailId"
                            class="form-control" 
                            required
                            />
                    </div>
<br>
                    <div>
                                <lable for="password" class="form-label"> Password </lable>
                            <input 
                            type="password" 
                            name="password" 
                            id="password"
                            class="form-control" 
                            required
                            />
                    </div>
<br>


                    <button class="btn btn-success">SignUp</button>

                    

                    

               

            </form>
    </div>
</div>