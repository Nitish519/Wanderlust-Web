<% layout("/layouts/boilerplate.ejs") %> 

<body>

    <h3>Create a New Listing</h3>
     <form action="/listings" method="POST" novalidate class="needs-validation"
      enctype="multipart/form-data">

        <div class="mb-3">
              <lable for="title" class="form-label"> Title </lable>

              <input type="text" name="listing[title]" placeholder="enter Title" class="form-control" required>

          <div class="valid-feedback">
                   <p>Title Looks Good!</p>
            </div>

        </div>




         <div class="mb-3">
                 <lable for="description" class="form-label"> Description</lable>
                  <textarea name="listing[description]" placeholder="enter description" class="form-control" required></textarea> 
        </div>


  <!-- //image upload -->                
          <div class="mb-3">
                   <lable for="image" class="form-label">Add Image</lable>
                   <input type="file" name="images"  class="form-control" multiple required>
         </div>


<div class="row"> 
            <div class="mb-3 col-3">
                     <lable for="price" class="form-label" >Price</lable>
                     <input type="number" name="listing[price]" placeholder="enter price" class="form-control" required>

                     <div class="invalid-feedback">
                        <p>Please add Valid Price!</p>
                    </div>
         </div>

          <div class="mb-3 col-5">

                 <lable for="location" class="form-label" >Location</lable>
                 <input type="text" name="listing[location]" placeholder="enter location" class="form-control" required>

                      <div class="invalid-feedback">
                        <p>Location should be provided!</p>
                  </div>
         </div>

</div>
          
         <div class="mb-3">
                     <lable for="country" class="form-label" >Country</lable>
                     <input type="text" name="listing[country]" placeholder="enter country" class="form-control" required>

                     <div class="invalid-feedback">
                        <p>Countrty name should be provided!</p>
                  </div>
         </div>
       
          <br>
        <button class="btn btn-dark add-btn">ADD</button>
      </form>
</body>
</html>