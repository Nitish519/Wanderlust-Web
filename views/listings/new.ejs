<% layout("/layouts/boilerplate.ejs") %> 

<body>

  <div class="container">
    <div class="form-wrapper">
        <div class="form-card">

  <h2 class="form-title">
    Create a New Listing
</h2>
     <form action="/listings" method="POST" novalidate class="needs-validation"
      enctype="multipart/form-data">

        <div class="mb-3">
              <lable for="title" class="form-label"> Title </lable>

              <input type="text" name="listing[title]" placeholder="enter Title" class="form-control" required>

          <div class="valid-feedback">
                   <p>Title Looks Good!</p>
            </div>

        </div>




         <div class="mb-3">
                 <lable for="description" class="form-label"> Description</lable>
                  <textarea name="listing[description]" placeholder="enter description" class="form-control" required></textarea> 
        </div>


  <!-- //image upload -->                
          <div class="mb-3">
                   <lable for="image" class="form-label">Add Image(maximum 5 images)</lable>
                   <input type="file" name="listing[images]"  class="form-control" multiple required>

                   <!-- <div class="invalid-feedback">
                        <p>you can upload maximum 5 images only</p>
                    </div> -->
         </div>



          <!-- Category -->
   <div class="mb-3">

              <label class="form-label">
                Category
              </label>

              <select
                name="listing[category]"
                class="form-select"
              >

                <option value="Hotels">
                  Hotels
                </option>

                <option value="Mountains">
                  Mountains
                </option>

                <option value="Cabins">
                  Cabins
                </option>

                <option value="Beaches">
                  Beaches
                </option>

                <option value="Snow">
                  Snow
                </option>

                <option value="Lakes">
                  Lakes
                </option>

              </select>

</div>


<div class="row g-3"> 
            <div class="mb-3 col-md-4">
                     <lable for="price" class="form-label" >Price</lable>
                     <input type="number" name="listing[price]" placeholder="enter price" class="form-control" required>

                     <div class="invalid-feedback">
                        <p>Please add Valid Price!</p>
                    </div>
         </div>

          <div class="mb-3 col-md-8">

                 <lable for="location" class="form-label" >Location</lable>
                 <input type="text" name="listing[location]" placeholder="enter location" class="form-control" required>

                      <div class="invalid-feedback">
                        <p>Location should be provided!</p>
                  </div>
         </div>

</div>
          
         <div class="mb-3">
                     <lable for="country" class="form-label" >Country</lable>
                     <input type="text" name="listing[country]" placeholder="enter country" class="form-control" required>

                     <div class="invalid-feedback">
                        <p>Countrty name should be provided!</p>
                  </div>
         </div>
       
          <br>
        <button class="btn btn-dark form-btn">ADD</button>
      </form>

              </div>
    </div>
</div>
</body>
</html>