<% layout("/layouts/boilerplate.ejs") %>

<body>

<div class="row">
    
    <div class="col-8 offset-1">
         <h2><%= detail.title %></h2>
        <div class="card  mt-3 show-card listing-card" >

<div class="row gallery">

          <!-- LEFT -->
          <div class="col-md-6">
            <img src="<%= detail.images[0]?.url %>" class="main-img rounded" style="width:100%; height:600px; object-fit:cover;">
          </div>

          <!-- RIGHT -->
          <div class="col-md-6 right-grid">
            <div class="row h-100 g-2">

              <% for(let i = 1; i < 5; i++) { %>
                <div class="col-6">
                  <img src="<%= detail.images[i]?.url %>" class="small-img rounded">
                </div>
              <% } %>

            </div>
          </div>

</div>
   

            <div class="card-body ms-1 offset-2">
                       <li><%= detail.description %></li>
                       <li>&#8377; <%= detail.price %></li>
                        <li>  <%= detail.location %></li>
                        <li><%= detail.country %></li>
                         <i class="offset-10"> Owned by <%= detail.owner.username %></i>                  
                     <%
                        let rating = Number(detail.avgRating) || 0;
                        let count = detail.numReviews || 0;

                        let fullStars = Math.floor(rating);
                        let hasHalf = rating % 1 >= 0.5;
                        let emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);
                     %>

      <% if(count === 0) { %>
        <p>No reviews yet</p>
      <% } else { %>

        <p class="mt-2">

          <% for(let i = 0; i < fullStars; i++) { %>
            ⭐
          <% } %>

          <% if(hasHalf) { %>
            ⭐
          <% } %>

          <% for(let i = 0; i < emptyStars; i++) { %>
            ☆
          <% } %>

          <span>
            <%= rating.toFixed(1) %> • <%= count %> reviews
          </span>

        </p>
      <% } %>
            </p>
                  </div>

 </div>
     <br>


<% if( currUser && currUser._id.equals(detail.owner._id)) { %>     

        <div class="row">
                 <div class="col-1">
                 <a href="/listings/<%=detail._id %>/edit"  class="btn btn-success edit-btn">Edit</a>
        </div>

    <div class="col-2 ms-1">
        <form action="/listings/<%= detail._id%>?_method=DELETE", method="POST">
                <button class="btn btn-danger del-btn">Delete </button>
            </form> 

    </div>

</div>

<hr>

<%} %>


<!--Render Review form -->
<div class="col-20 offset-1">

    <%   if(currUser) { %>  
              <h4><b>Leave a Review</b></h4>
              <form class="mb-3 needs-validation" action="/listings/<%= detail.id %>/reviews" method="POST" novalidate >      

<div class="mb-3 mt-3">
      <label for="rating" class="form-label">Rating</label>

<fieldset class="starability-basic">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value= 1 />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>

</div>
                 <div class="mb-3 mt-3">
                            <label for="comment" class="form-label">Comments</label>
                            <textarea name="review[comment]" id="comment" rows="8" cols="50" class="form-control" required></textarea>


                            <div class="invalid-feedback">
                                please submit some comments for review
                            </div>
                  </div>

                        <button class="btn btn-outline-dark">Submit</button>
       </form>

                <% } %>

                

                  <hr>

                  <h4><b>All Reviews</b></h4>            
                  
                   </ul>

               <div class="row">
                    <% for(review of detail.reviews){ %> 
                        <div class="card col-5 ms-2 mb-3"> 
                            <div class="card-body">
                                <h5 class="card-title"><b><%=review.author.username%></b></h5>
                                <p class="card-text"><%=review.comment%></p>
                           
                                  <p class="starability-result card-text" data-rating="<%=review.rating %>">Rated</p>
                            </div>

         <!--authorization for deleting review-->
         <% if(currUser && (currUser._id.equals(review.author._id) || currUser._id.equals(detail.owner._id))) { %>
                            <form action="/listings/<%= detail._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3" method="POST"> 
                                <button class="btn btn-sm btn-dark ms-2">Delete</button>
                            </form>

                        <% } %>


                        </div>
                    <%}%>

                    </div>
            </div>
    </div>
</div>
</body>


