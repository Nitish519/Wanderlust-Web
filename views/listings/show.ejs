<% layout("/layouts/boilerplate.ejs") %>

<body>

<div class="container py-4">

    <!-- Title -->
    <h2 class="fw-bold mb-4">
        <%= listing.title %>
    </h2>

    <!-- IMAGE GALLERY -->
    <div class="row g-3 mb-4">

        <!-- Main Image -->
        <div class="col-lg-7">

            <% if(listing.images[0]?.url){ %>

                <img
                    src="<%= listing.images[0].url %>"
                    class="show-main-img"
                >

            <% } else { %>

              <div class="placeholder-box">

                <i class="fa-regular fa-image"></i>

                <p>
                    No Image Available
                </p>

            </div>

            <% } %>

        </div>

        <!-- Side Grid -->
        <div class="col-lg-5">

            <div class="row g-2 h-100">

                <% for(let i = 1; i < 5; i++) { %>

                    <div class="col-6">

                        <% if(listing.images[i]?.url){ %>

                            <img
                                src="<%= listing.images[i].url %>"
                                class="show-small-img"
                            >

                        <% } else { %>

                            <div class="placeholder-box">

                                <i class="fa-regular fa-image"></i>

                                <p>
                                    No Image Available
                                </p>

                            </div>

                        <% } %>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

    <!-- DETAILS -->
    <div class="row g-4">

        <!-- LEFT -->
        <div class="col-lg-8">

            <div class="details-card p-4">

                <!-- price -->
                <h4 class="fw-bold mb-3">
                    ₹ <%= listing.price %>
                    <span class="text-muted fs-6">
                        / night
                    </span>
                </h4>

                <!-- location -->
                <p class="location-text mb-3">
                    <i class="fa-solid fa-location-dot"></i>
                    <%= listing.location %>,
                    <%= listing.country %>
                </p>

                <!-- category -->
                <span class="badge bg-dark mb-3">
                    <%= listing.category %>
                </span>

                <!-- description -->
                <h5 class="fw-bold mt-3">
                    Description
                </h5>

                <p class="description-text">
                    <%= listing.description %>
                </p>

                <!-- owner -->
                <div class="owner-box mt-4">
                    <p class="mb-0">
                        Hosted by
                        <b>
                            <%= listing.owner.username %>
                        </b>
                    </p>
                </div>

                <!-- rating -->
                <%
                    let rating = Number(listing.avgRating) || 0;
                    let count = listing.numReviews || 0;

                    let fullStars = Math.floor(rating);
                    let hasHalf = rating % 1 >= 0.5;
                    let emptyStars =
                    5 - fullStars - (hasHalf ? 1 : 0);
                %>

                <div class="mt-4">

                    <% if(count === 0) { %>

                       <div class="empty-review-state">

                          <i class="fa-regular fa-message empty-review-icon"></i>

                          <h5>
                              No Reviews Yet
                          </h5>

                          <p>
                              Be the first one to review this place.
                          </p>

                      </div>

                    <% } else { %>

                        <p class="rating-text">

                            <% for(let i = 0; i < fullStars; i++) { %>
                                ⭐
                            <% } %>

                            <% if(hasHalf) { %>
                                ⭐
                            <% } %>

                            <% for(let i = 0; i < emptyStars; i++) { %>
                                ☆
                            <% } %>

                            <span class="ms-2">
                                <%= rating.toFixed(1) %>
                                ·
                                <%= count %> reviews
                            </span>

                        </p>

                    <% } %>

                </div>

            </div>

            <!-- OWNER ACTIONS -->
            <% if(currUser && currUser._id.equals(listing.owner._id)) { %>

                <div class="d-flex gap-3 mt-4">

                    <a
                        href="/listings/<%=listing._id %>/edit"
                        class="btn btn-dark px-4"
                    >
                        Edit
                    </a>

                    <form
                        action="/listings/<%= listing._id %>?_method=DELETE"
                        method="POST"
                    >
                        <button
                            class="btn btn-outline-danger px-4"
                        >
                            Delete
                        </button>
                    </form>

                </div>

            <% } %>

        </div>

        <!-- RIGHT SIDE -->
        <div class="col-lg-4">

            <% if(currUser) { %>

                <div class="review-box p-4">

                    <h5 class="fw-bold mb-3">
                        Leave a Review
                    </h5>

                    <form
                        class="needs-validation"
                        action="/listings/<%= listing._id %>/reviews"
                        method="POST"
                        novalidate
                    >

                        <fieldset class="starability-basic mb-3">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5">5 stars</label>
                        </fieldset>

                        <textarea
                            name="review[comment]"
                            rows="5"
                            class="form-control mb-3"
                            placeholder="Share your experience..."
                            required
                        ></textarea>

                        <button class="btn btn-dark w-100">
                            Submit Review
                        </button>

                    </form>

                </div>

            <% } %>

        </div>

    </div>

    <!-- REVIEWS -->
    <div class="mt-5">

        <h4 class="fw-bold mb-4">
            Reviews
        </h4>

        <div class="row g-4">
            <% for(let review of listing.reviews){ %>

            <% if(!review) continue; %>

                <div class="col-md-6">

                    <div class="review-card p-3 h-100">

                        <h6 class="fw-bold">
                           <%= review.author?.username || "Anonymous" %>
                        </h6>

                        <p class="text-muted">
                            <%= review.comment %>
                        </p>

                        <p
                            class="starability-result"
                            data-rating="<%=review.rating %>"
                        >
                            Rated
                        </p>

                        <% if(currUser &&
                        (currUser._id.equals(review.author._id)
                        || currUser._id.equals(listing.owner._id))) { %>

                            <form
                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                method="POST"
                            >

                                <button
                                    class="btn btn-sm btn-outline-dark"
                                >
                                    Delete
                                </button>

                            </form>

                        <% } %>

                    </div>

                </div>

            <% } %>

        </div>

    </div>

</div>

</body>