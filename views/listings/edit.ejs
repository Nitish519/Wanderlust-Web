<% layout("/layouts/boilerplate.ejs") %>

<body>

    <h3 class="form-title"> Edit Listing Details</h3>

    <form
        action="/listings/<%= listing._id %>?_method=PUT"
        method="POST"
        novalidate
        class="needs-validation"
        enctype="multipart/form-data"
    >

        <!-- Title -->
        <div class="mb-3">
            <lable for="title" class="form-label">
                Title
            </lable>

            <input
                type="text"
                name="listing[title]"
                placeholder="Enter Title"
                value="<%= listing.title %>"
                class="form-control"
                required
            >
        </div>

        <!-- Description -->
        <div class="mb-3">
            <lable for="description" class="form-label">
                Description
            </lable>

            <textarea
                name="listing[description]"
                placeholder="Enter description"
                class="form-control"
                style="height: 100px;"
                required
            ><%= listing.description %></textarea>
        </div>

<!-- //before you implemented coursoule feature here, there you can only see imaghes  -->


        <!-- Delete Images Section -->
        <% if (listing.images && listing.images.length > 0) { %>

            <div class="mb-4">

                <h5 class="mb-3">
                    Select Images to Delete <small class="text-muted"> (Selected images will be permanently deleted)</small>
                </h5>

                <div class="row">

                    <% listing.images.forEach((img) => { %>

                        <div class="col-md-4 mb-3">

                            <div class="card delete-image-card">

                                <img
                                    src="<%= img.url %>"
                                    class="card-img-top"
                                    style="height: 250px; object-fit: cover;"
                                >

                                <div class="card-body text-center">

                                    <div class="form-check d-flex justify-content-center align-items-center gap-2">

                                        <input
                                            type="checkbox"
                                            class="form-check-input"
                                            name="deleteImages"
                                            value="<%= img.filename %>"
                                        >

                                        <lable class="form-check-label">
                                            Delete Image
                                        </lable>

                                    </div>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                </div>

            </div>

        <% } %>

        <!-- Upload New Images -->
        <div class="mb-3">

            <lable class="form-label">
                Upload New Images  <small> (you can have total 5 images for a listing)</small>
            </lable>

           <input
            type="file"
            name="listing[images]"
            class="form-control"
            multiple
            accept="image/*"
            id="editImageUpload"
            >

            

        </div>





        <!-- Category -->
   <div class="mb-3">

              <lable class="form-label">
                Category
              </lable>

              <select
                name="listing[category]"
                class="form-select"
              >

                <option value="Hotels"
                  <%= listing.category === "Hotels" ? "selected" : "" %>>
                  Hotels
                </option>

                <option value="Mountains"
                  <%= listing.category === "Mountains" ? "selected" : "" %>>
                  Mountains
                </option>

                <option value="Cabins"
                  <%= listing.category === "Cabins" ? "selected" : "" %>>
                  Cabins
                </option>

                <option value="Beaches"
                  <%= listing.category === "Beaches" ? "selected" : "" %>>
                  Beaches
                </option>

                <option value="Snow"
                  <%= listing.category === "Snow" ? "selected" : "" %>>
                  Snow
                </option>

                <option value="Lakes"
                  <%= listing.category === "Lakes" ? "selected" : "" %>>
                  Lakes
                </option>

              </select>

</div>

        <!-- Price -->
        <div class="mb-3">

            <lable for="price" class="form-label">
                Price
            </lable>

            <input
                type="number"
                name="listing[price]"
                placeholder="Enter price"
                value="<%= listing.price %>"
                class="form-control"
                required
            >

        </div>

    

        <!-- Location -->
        <div class="mb-3">

            <lable for="location" class="form-label">
                Location
            </lable>

            <input
                type="text"
                name="listing[location]"
                placeholder="Enter location"
                value="<%= listing.location %>"
                class="form-control"
                required
            >

        </div>


            <!-- Country -->
        <div class="mb-3">

            <lable for="country" class="form-label">
                Country
            </lable>

            <input
                type="text"
                name="listing[country]"
                placeholder="Enter country"
                value="<%= listing.country %>"
                class="form-control"
                required
            >

        </div>

        <!-- Submit -->
        <button class="btn btn-dark edit-btn mb-3">
            Edit Listing
        </button>

    </form>

</body>