<% layout("/layouts/boilerplate.ejs") %>
   
<body>

  <div id="filters">
   <a href="/listings?search=<%= search || '' %>&priceRange=<%= priceRange %>&category=Hotels"  class="filter-link">
      <div class="filter">
        <i class="fa-solid fa-bed"></i>
        <p>Hotels</p>
      </div>
    </a>
  <a href="/listings?search=<%= search || '' %>&priceRange=<%= priceRange %>&category=Mountains" class="filter-link">
        <div class="filter">
          <i class="fa-solid fa-mountain"></i>
            <p>Mountains</p>
          </div>
    </a>
      <a href="/listings?search=<%= search || '' %>&priceRange=<%= priceRange %>&category=Cabins" class="filter-link">
          <div class="filter">
          <i class="fa-solid fa-tree"></i>
            <p>Cabins</p>   
          </div>
      </a>

       <a href="/listings?search=<%= search || '' %>&priceRange=<%= priceRange %>&category=Beaches" class="filter-link">
          <div class="filter">
            <i class="fa-solid fa-umbrella-beach"></i>
            <p>Beaches</p>
          </div>
        </a>

        <a href="/listings?search=<%= search || '' %>&priceRange=<%= priceRange %>&category=Snow" class="filter-link">
          <div class="filter">
            <i class="fa-solid fa-snowflake"></i>
            <p>Snow</p>
          </div>
        </a>

         

        <a href="/listings?search=<%= search || '' %>&priceRange=<%= priceRange %>&category=Lakes" class="filter-link">
           <div class="filter">
              <i class="fa-solid fa-water"></i>
                <p>Lakes</p>

          </div>
        </a>

   
 <div class="tax-toggle">

          <div class="form-check-reverse form-switch">  
                        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                        <label class="form-check-label" for="switchCheckDefault">Display after taxes</label>
          </div>

 </div>   


 <!-- //price range filter -->


      <div class="mb-3">

              <!-- <h6>Filter by Price</h6> -->

              <form action="/listings" method="GET" class="d-flex align-items-center gap-2 mt-4">

                <!-- Preserve search -->
                <input
                  type="hidden"
                  name="search"
                  value="<%= search %>"
                >


                <input
                  type="hidden"
                  name="category"
                  <%# value=" req.query.category || ''" %>
                  value ="<%= category %>"
                >

                

              <select
                name="priceRange"
                class="form-select budget-select"
                onchange="this.form.submit()"
              >

                <option value="">
                  Select Budget
                </option>

                <option
                  value="0-2000"
                  <%= priceRange === "0-2000" ? "selected" : "" %>>
                  ₹0–2000
                </option>

                <option
                  value="2000-3000"
                  <%= priceRange === "2000-3000" ? "selected" : "" %>>
                  ₹2000–3000
                </option>

                <option
                  value="3000-4000"
                  <%= priceRange === "3000-4000" ? "selected" : "" %>>
                  ₹3000–4000
                </option>

                <option
                  value="5000"
                  <%= priceRange === "5000" ? "selected" : "" %>>
                  ₹5000+
                </option>

              </select>


                <a
                  href="/listings"
                  class="btn btn-dark btn-md text-nowrap mt-1"
                >
                  Clear Filters
                </a>

              </form>

            </div>


  </div>











<div class="container-fluid px-5 mt-4">

  <h2 class="mb-4 text-center">All Listings</h2>
  <% if (allListings.length === 0) { %>

<div class="empty-state">

    <i class="fa-solid fa-house-circle-xmark empty-icon"></i>

    <h3>
        No Listings Found
    </h3>

    <p>
        Try changing filters or search again.
    </p>

    <a
        href="/listings"
        class="btn btn-dark empty-btn"
    >
        Clear Filters
    </a>

</div>


<% } else { %>

  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-5">

   

  <% for(let listing of allListings) { %>

      <div class="col">
        <a href="/listings/<%= listing._id %>" class="listing-link">

          <div class="listing-card">



 <!--carousel feature-->
<div id="listingCarousel-<%= listing._id %>" class="carousel slide">

  <div class="carousel-inner">

    <% if (listing.images && listing.images.length > 0) { %>

      <% listing.images.forEach((img, index) => { %>
        <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
          <img src="<%=img.url %>" class="card-img-top" alt="Image Not Available" >
        </div>
      <% }) %>

    <% } 
    else { %>

  //  fallback image
   <div class="carousel-item active">
        <img 
          src="https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b" 
          class="d-block w-100 rounded" 
          style="height: 400px; object-fit: cover;"
        >
      </div>
  <% } %>


  </div>
    

 <% if (listing.images && listing.images.length > 1) { %>

  <!-- Previous button -->
  <button
    class="carousel-control-prev"
    type="button"
    data-bs-target="#listingCarousel-<%= listing._id %>"
    data-bs-slide="prev"
  >
    <span class="carousel-control-prev-icon"></span>
  </button>

  <!-- Next button -->
  <button
    class="carousel-control-next"
    type="button"
    data-bs-target="#listingCarousel-<%= listing._id %>"
    data-bs-slide="next"
  >
    <span class="carousel-control-next-icon"></span>
  </button>

<% } %>

</div>

            <div class="listing-info">
             <h6 class="listing-title">
    <%= listing.title %>
</h6>

<p class="listing-price">
    ₹ <%= listing.price %> / night
    <i class="tax-info">
        + 18% GST
    </i>
</p>

<p class="listing-location">
    <%= listing.location %>,
    <%= listing.country %>
</p>

            </div>
          </div>

        </a>
      </div>
    <% } %>
     <% } %>

  </div>
</div>

  
  <script>
     let taxSwitch=document.getElementById('switchCheckDefault');
     taxSwitch.addEventListener("click",function(){
       
        let taxInfo = document.getElementsByClassName('tax-info');
        for(let info of taxInfo){

          if(info.style.display === "inline"){
            info.style.display = "none";
           
          }else{
                info.style.display = "inline";
          }
        
        }
     });
</script>
   
</body>