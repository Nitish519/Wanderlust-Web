<body class="d-flex flex-column min-vh-100">

  <%- include("../includes/navbar.ejs") %>

  <!-- <h2 class="px-5 mt-3">This is my Travel website</h2> -->

  <!-- 🔥 THIS IS THE KEY -->
  <!-- flash messages are rendered in the boilerplate layout,
    so they will appear on any page that extends this layout. 
    This way, you don't have to include the flash message rendering code in every single view.
     Instead, you can just set flash messages in your routes,
      and they will automatically be displayed in the layout when the page is rendered. -->
  <main class="container-fluid px-5 flex-grow-1">
    <%- include("../includes/flash.ejs") %>
    <%- body %>
  </main>

  <%- include("../includes/footer.ejs") %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
