
<!-- // weuse this file in boilerplate.ejs -->

<!-- <h1>flash massage for success</h1> -->
<% if(success && success.length) { %>
        <div class="alert alert-success alert-dismissible fade show col-6 offset-1" role="alert"> 
            <%= success %>
        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close"   
            >
        </button>
        </div>
       
<%} %>


<% if(error && error.length) { %>
        <div class="alert alert-danger alert-dismissible fade show col-6 offset-1" role="alert"> 
            <%= error %>
        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close"   
            >
        </button>
        </div>
       
<%} %>




