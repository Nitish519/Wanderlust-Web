<% layout("/layouts/boilerplate") %>

<div class="row">

    <div
        class="alert alert-danger col-md-6 offset-md-3 mt-4"
        role="alert"
    >

        <i
            class="fa-solid fa-circle-exclamation me-2"
        ></i>

        <h4 class="alert-heading">
            <%= message || "Something went wrong" %>
        </h4>

    </div>

</div>
